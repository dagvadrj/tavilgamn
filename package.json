{
  "name": "tavilgamn",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.14 <23"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "scripts": {
    "models:decoders": "node scripts/models/sync-decoders.mjs",
    "models:pipeline": "node --env-file=.env.local scripts/models/pipeline.mjs",
    "models:compress": "node scripts/models/optimize-glb.mjs",
    "models:fetch": "node --env-file=.env.local scripts/models/fetch-r2.mjs",
    "models:fetch:2": "node --env-file=.env.local scripts/models/fetch-r2.mjs --output=model-work/source --limit=2",
    "models:worker": "node --env-file=.env.local scripts/models/worker.mjs",
    "models:backfill-previews": "node --env-file=.env.local scripts/models/backfill-previews.mjs",
    "predev": "npm run models:decoders",
    "prebuild": "npm run models:decoders",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "env:check": "node --env-file-if-exists=.env.local scripts/validate-env.mjs",
    "env:check:production": "node --env-file-if-exists=.env.local scripts/validate-env.mjs --production",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "node --test tests/*.test.cjs",
    "test:visual": "node scripts/verify/kitchen-visual.cjs",
    "verify": "npm run env:check && npm run styles:check && npm run lint && npm run typecheck && npm test && npm run build",
    "styles:check": "node scripts/styles/check.mjs",
    "styles:format": "node scripts/styles/check.mjs --write"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.1",
    "@supabase/server": "^1.5.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "next": "15.5.26",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "three-bvh-csg": "^0.0.17",
    "uuid": "^11.0.3",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@gltf-transform/cli": "4.5.0",
    "@types/node": "^22.9.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.170.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.26",
    "postcss": "^8.4.49",
    "postcss-selector-parser": "^6.1.4",
    "sharp": "0.35.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  }
}
